# Railway service variables for the django CMS demo (set them in Railway, never commit real values).

# PostgreSQL server; the demo creates and uses the database DJANGOCMS_DB_NAME on it.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# DJANGOCMS_DB_NAME=djangocms

# Random secret (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=

# Demo accounts, created on every start if they don't exist yet (existing accounts are never
# changed). Log in at /en/admin/ with the e-mail address. Passwords must pass Django's password
# validators (at least 8 characters, not too common, not only digits, not like the e-mail address).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Member of the "Editors" group: pages and text in every language, may translate with Supertext.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext
SUPERTEXT_API_KEY=
# Optional, e.g. a stand-in API: http://127.0.0.1:8765/v1/
# SUPERTEXT_API_URL=

# Set by Railway
# PORT=8000
# RAILWAY_PUBLIC_DOMAIN=
