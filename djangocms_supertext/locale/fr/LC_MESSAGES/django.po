msgid ""
msgstr ""
"Project-Id-Version: djangocms-supertext-translation\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "API"
msgstr "API"

msgid "API key"
msgstr "Clé API"

msgid "Already translated"
msgstr "Déjà traduite"

msgid "Already translated."
msgstr "Déjà traduite."

msgid "Can translate pages with Supertext"
msgstr "Peut traduire des pages avec Supertext"

msgid ""
"Checks the API key against the Supertext API. Nothing is translated or "
"charged."
msgstr ""
"Vérifie la clé API auprès de l’API Supertext. Rien n’est traduit ni facturé."

msgid "Connection"
msgstr "Connexion"

msgid "Default"
msgstr "Par défaut"

msgid "Form of address"
msgstr "Forme d’adresse"

msgid "Formal (Sie, vous)"
msgstr "Formel (Sie, vous)"

msgid "From"
msgstr "De"

msgid "Informal (du, tu)"
msgstr "Informel (du, tu)"

msgid "Into"
msgstr "Vers"

msgid "Language"
msgstr "Langue"

msgid "Languages"
msgstr "Langues"

msgid ""
"Languages that already exist are replaced by a new translation of the "
"source: the page fields and all plugins. Changes made in those languages are"
" lost. Leave this off to translate only the missing languages."
msgstr ""
"Les langues existantes sont remplacées par une nouvelle traduction de la "
"source : les champs de la page et tous les plugins. Les modifications faites"
" dans ces langues sont perdues. Laissez cette option désactivée pour ne "
"traduire que les langues manquantes."

msgid "Missing: set SUPERTEXT_API_KEY"
msgstr "Manquante : définissez SUPERTEXT_API_KEY"

msgid "No Supertext API key is configured. Set SUPERTEXT_API_KEY."
msgstr ""
"Aucune clé API Supertext n’est configurée. Définissez SUPERTEXT_API_KEY."

msgid "Open"
msgstr "Ouvrir"

msgid ""
"Open a language to review it, or close this dialog and reload the page."
msgstr ""
"Ouvrez une langue pour la relire, ou fermez cette fenêtre et rechargez la "
"page."

msgid "Overwrite existing translations"
msgstr "Écraser les traductions existantes"

msgid "Page"
msgstr "Page"

msgid "Set (SUPERTEXT setting)"
msgstr "Définie (paramètre SUPERTEXT)"

msgid "Set (environment variable SUPERTEXT_API_KEY)"
msgstr "Définie (variable d’environnement SUPERTEXT_API_KEY)"

msgid "Settings"
msgstr "Paramètres"

msgid "Settings and connection"
msgstr "Paramètres et connexion"

msgid "Supertext"
msgstr "Supertext"

msgid ""
"Supertext is not set up yet: an administrator needs to set "
"SUPERTEXT_API_KEY."
msgstr ""
"Supertext n’est pas encore configuré : un administrateur doit définir "
"SUPERTEXT_API_KEY."

msgid "Supertext language"
msgstr "Langue Supertext"

msgid "Supertext settings"
msgstr "Paramètres Supertext"

msgid ""
"Supertext translates the saved content of the source language. Each language"
" takes a few seconds."
msgstr ""
"Supertext traduit le contenu enregistré de la langue source. Chaque langue "
"prend quelques secondes."

msgid "Supertext translation"
msgstr "Traduction Supertext"

msgid "Supertext translations"
msgstr "Traductions Supertext"

msgid "Test connection"
msgstr "Tester la connexion"

msgid "The page has no %(language)s version to translate from."
msgstr ""
"La page n’a pas de version %(language)s à partir de laquelle traduire."

msgid ""
"This language is published. Create a draft of it, then translate again."
msgstr ""
"Cette langue est publiée. Créez-en un brouillon, puis traduisez à nouveau."

msgid "Timeout per language"
msgstr "Délai par langue"

msgid "Plugin version"
msgstr "Version du plugin"

msgid "Translate"
msgstr "Traduire"

msgid "Translate with Supertext"
msgstr "Traduire avec Supertext"

msgid "Translated with Supertext on %(date)s"
msgstr "Traduite avec Supertext le %(date)s"

msgid "Translating…"
msgstr "Traduction en cours…"

msgid "already translated, skipped"
msgstr "déjà traduite, ignorée"

msgid "date"
msgstr "date"

msgid "error"
msgstr "erreur"

msgid "from"
msgstr "de"

msgid "into"
msgstr "vers"

msgid "message"
msgstr "message"

msgid "page"
msgstr "page"

msgid "skipped"
msgstr "ignorée"

msgid "status"
msgstr "statut"

msgid "translated"
msgstr "traduite"

msgid "translation created"
msgstr "traduction créée"

msgid "translation replaced"
msgstr "traduction remplacée"

msgid "user"
msgstr "utilisateur"

msgid ""
"No Supertext account yet? <a href=\"%(signup_url)s\" target=\"_blank\" "
"rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at "
"<a href=\"%(api_key_url)s\" target=\"_blank\" rel=\"noopener\">supertext.com"
" → Integrations → API</a> (requires the Admin role)."
msgstr ""
"Pas encore de compte Supertext ? <a href=\"%(signup_url)s\" "
"target=\"_blank\" rel=\"noopener\">Créez-en un sur supertext.com</a>. "
"Générez votre clé API sur <a href=\"%(api_key_url)s\" target=\"_blank\" "
"rel=\"noopener\">supertext.com → Integrations → API</a> (rôle Admin requis)."

msgid "Supertext did not return a file id."
msgstr "Supertext n’a pas renvoyé d’identifiant de fichier."

msgid "Supertext could not translate the document."
msgstr "Supertext n’a pas pu traduire le document."

msgid ""
"Your Supertext translation limit is exceeded. Please upgrade your "
"subscription."
msgstr ""
"Votre limite de traduction Supertext est dépassée. Veuillez passer à un "
"abonnement supérieur."

msgid "The document was deleted at Supertext before it could be downloaded."
msgstr ""
"Le document a été supprimé chez Supertext avant de pouvoir être téléchargé."

msgid "Timed out waiting for the Supertext translation."
msgstr "Délai dépassé en attendant la traduction Supertext."

msgid "The translated document was empty."
msgstr "Le document traduit était vide."

msgid ""
"No Supertext API key is configured. No Supertext account yet? Create one at "
"%(signup_url)s. Generate your API key at %(api_key_url)s (supertext.com → "
"Integrations → API, requires the Admin role)."
msgstr ""
"Aucune clé API Supertext n’est configurée. Pas encore de compte Supertext ? "
"Créez-en un sur %(signup_url)s. Générez votre clé API sur %(api_key_url)s "
"(supertext.com → Integrations → API, rôle Admin requis)."

msgid "Could not reach Supertext: %(error)s"
msgstr "Impossible de joindre Supertext : %(error)s"

msgid ""
"Authentication failed. Please check the Supertext API key. No Supertext "
"account yet? Create one at %(signup_url)s. Generate a new API key at "
"%(api_key_url)s (requires the Admin role)."
msgstr ""
"Échec de l’authentification. Veuillez vérifier la clé API Supertext. Pas "
"encore de compte Supertext ? Créez-en un sur %(signup_url)s. Générez une "
"nouvelle clé API sur %(api_key_url)s (rôle Admin requis)."

msgid "The requested Supertext resource was not found."
msgstr "La ressource Supertext demandée est introuvable."

msgid "The content is too large for Supertext to translate in one go."
msgstr ""
"Le contenu est trop volumineux pour être traduit par Supertext en une seule "
"fois."

msgid "Too many requests to Supertext. Please try again shortly."
msgstr ""
"Trop de requêtes envoyées à Supertext. Veuillez réessayer dans un instant."

msgid "The Supertext service is currently unavailable."
msgstr "Le service Supertext est actuellement indisponible."

msgid "Supertext answered with HTTP %(code)s."
msgstr "Supertext a répondu avec HTTP %(code)s."

msgid "API key check"
msgstr "Vérification de la clé API"

msgid "API key checked: the connection to Supertext works."
msgstr "Clé API vérifiée : la connexion à Supertext fonctionne."

msgid ""
"No API key is set yet. No Supertext account yet? Create one at "
"supertext.com. Generate your API key at supertext.com → Integrations → API "
"(requires the Admin role)."
msgstr ""
"Aucune clé API n'est encore saisie. Pas encore de compte Supertext ? Créez-"
"en un sur supertext.com. Générez votre clé API sur supertext.com → "
"Integrations → API (rôle Admin requis)."

msgid "Not checked yet."
msgstr "Pas encore vérifiée."

msgid "Off (SUPERTEXT_VERSION_REPORTS=0)"
msgstr "Désactivé (SUPERTEXT_VERSION_REPORTS=0)"

msgid "Off (VERSION_REPORTS in the SUPERTEXT setting)"
msgstr "Désactivé (VERSION_REPORTS dans le paramètre SUPERTEXT)"

msgid "On"
msgstr "Activé"

msgid "Ping address"
msgstr "Adresse de ping"

msgid "Send version information to Supertext"
msgstr "Envoyer les informations de version à Supertext"

msgid ""
"Sends the site URL and the versions of this plugin, django CMS and the "
"runtime to Supertext after an update and when the API key changes, so "
"Supertext support can see which version you run. No content, no API key and "
"no personal data are sent. Turn it off with VERSION_REPORTS: False in the "
"SUPERTEXT setting or SUPERTEXT_VERSION_REPORTS=0."
msgstr ""
"Envoie à Supertext l'URL du site ainsi que les versions de ce plugin, de "
"django CMS et de l'environnement d'exécution après une mise à jour et "
"lorsque la clé API change. Le support Supertext voit ainsi quelle version "
"vous utilisez. Aucun contenu, aucune clé API et aucune donnée personnelle ne"
" sont transmis. Désactivez-le avec VERSION_REPORTS: False dans le paramètre "
"SUPERTEXT ou SUPERTEXT_VERSION_REPORTS=0."

msgid "Status"
msgstr "Statut"

msgid "Supertext languages"
msgstr "Langues Supertext"

msgid "Supertext offers no formal/informal choice for this language"
msgstr "Supertext ne propose pas de choix formel/informel pour cette langue"

msgid ""
"Supertext rejected the API key. Check that you copied the whole key, or "
"generate a new one at supertext.com → Integrations → API (requires the Admin"
" role). No Supertext account yet? Create one at supertext.com."
msgstr ""
"Supertext a refusé la clé API. Vérifiez que vous avez copié la clé entière "
"ou générez-en une nouvelle sur supertext.com → Integrations → API (rôle "
"Admin requis). Pas encore de compte Supertext ? Créez-en un sur "
"supertext.com."

msgid ""
"The API key couldn't be checked because Supertext can't be reached. The "
"settings are saved; check again later."
msgstr ""
"La clé API n'a pas pu être vérifiée, car Supertext n'est pas joignable. Les "
"paramètres sont enregistrés ; réessayez plus tard."

msgid ""
"The API key couldn't be checked: Supertext answered with an error "
"(%(status)s). The settings are saved; check again later."
msgstr ""
"La clé API n'a pas pu être vérifiée : Supertext a répondu par une erreur "
"(%(status)s). Les paramètres sont enregistrés ; réessayez plus tard."

msgid "checked %(time)s"
msgstr "vérifiée %(time)s"

msgid "%(code)s is not a Supertext language."
msgstr "%(code)s n’est pas une langue Supertext."

msgid ""
"Choose the Supertext language for each django CMS language. It is used in "
"both directions: to translate into the language and from it. A suggestion is"
" preselected where Supertext has an obvious one (de → German (Germany), en →"
" English (US), es-es → Spanish); choose another one if your site means "
"something else (e.g. de-CH for Swiss German)."
msgstr ""
"Choisissez la langue Supertext de chaque langue de django CMS. Elle sert "
"dans les deux sens : pour traduire vers la langue et à partir d’elle. Une "
"suggestion est présélectionnée lorsque Supertext en a une évidente (de → "
"allemand (Allemagne), en → anglais (États-Unis), es-es → espagnol) ; "
"choisissez-en une autre si votre site entend autre chose (p. ex. fr-CH pour "
"le français de Suisse)."

msgid "No choice for this language"
msgstr "Pas de choix pour cette langue"

msgid ""
"No Supertext language: choose one, otherwise this language cannot be "
"translated."
msgstr ""
"Aucune langue Supertext : choisissez-en une, sinon cette langue ne peut pas "
"être traduite."

msgid "Save languages"
msgstr "Enregistrer les langues"

msgid ""
"Set under LANGUAGES in the SUPERTEXT setting, which wins over this page."
msgstr ""
"Défini sous LANGUAGES dans le paramètre SUPERTEXT, qui prime sur cette page."

msgid "Set under LANGUAGES in the SUPERTEXT setting."
msgstr "Défini sous LANGUAGES dans le paramètre SUPERTEXT."

msgid "Suggested. It is used until you choose another one."
msgstr ""
"Suggestion. Elle est utilisée tant que vous n’en choisissez pas une autre."

msgid ""
"Supertext does not support this language pair (%(source)s → %(target)s). "
"Check the Supertext languages under Supertext → Supertext translations → "
"Settings and connection → Languages."
msgstr ""
"Supertext ne prend pas en charge cette paire de langues (%(source)s → "
"%(target)s). Vérifiez les langues Supertext sous Supertext → Traductions "
"Supertext → Paramètres et connexion → Langues."

msgid "Supertext language for %(name)s"
msgstr "Langue Supertext pour %(name)s"

msgid ""
"Supertext offers no formal or informal tone for this language (%(target)s). "
"Set its form of address to the default under Supertext → Supertext "
"translations → Settings and connection → Languages."
msgstr ""
"Supertext ne propose pas de ton formel ou informel pour cette langue "
"(%(target)s). Réglez sa forme d’adresse sur « Par défaut » sous Supertext → "
"Traductions Supertext → Paramètres et connexion → Langues."

msgid "The Supertext languages were saved."
msgstr "Les langues Supertext ont été enregistrées."

msgid ""
"The language %(language)s has no Supertext language yet. Ask your "
"administrator to choose one under Supertext → Supertext translations → "
"Settings and connection → Languages."
msgstr ""
"La langue %(language)s n’a pas encore de langue Supertext. Demandez à votre "
"administrateur d’en choisir une sous Supertext → Traductions Supertext → "
"Paramètres et connexion → Langues."

msgid "django CMS language"
msgstr "langue django CMS"

msgid "form of address"
msgstr "forme d’adresse"

msgid "— choose —"
msgstr "— choisir —"

msgid "File format"
msgstr "Format de fichier"

msgid "XLIFF 1.2 (for translation tools)"
msgstr "XLIFF 1.2 (pour les outils de traduction)"

msgid "HTML (one language per file)"
msgstr "HTML (une langue par fichier)"

msgid "Translated file (XLIFF or HTML)"
msgstr "Fichier traduit (XLIFF ou HTML)"

msgid "Also import texts whose source changed since the export"
msgstr "Importer aussi les textes dont la source a changé depuis l’export"

msgid "Export for translation"
msgstr "Exporter pour traduction"

msgid "Import translation"
msgstr "Importer une traduction"

msgid "Download file"
msgstr "Télécharger le fichier"

msgid ""
"Translate the file in a translation tool, by a translator or in the "
"Supertext web app, then import it here."
msgstr ""
"Faites traduire le fichier dans un outil de traduction, par un traducteur ou"
" dans l’application web Supertext, puis importez-le ici."

msgid "The file is too large (at most 10 MB)."
msgstr "Le fichier est trop volumineux (10 Mo au maximum)."

msgid "Choose one language for an HTML file, or one or more for XLIFF."
msgstr ""
"Choisissez une langue pour un fichier HTML, ou une ou plusieurs pour XLIFF."

msgid "Nothing to translate."
msgstr "Rien à traduire."

msgid "This file isn't a valid XLIFF or HTML translation file."
msgstr "Ce fichier n’est pas un fichier de traduction XLIFF ou HTML valide."

msgid ""
"This file wasn't exported by the Supertext plugin, or its header was "
"removed."
msgstr ""
"Ce fichier n’a pas été exporté par le plugin Supertext, ou son en-tête a été"
" supprimé."

msgid "This file belongs to another system (%(plugin)s)."
msgstr "Ce fichier appartient à un autre système (%(plugin)s)."

msgid "The page this file was exported from no longer exists."
msgstr "La page à partir de laquelle ce fichier a été exporté n’existe plus."

msgid "The site has no language %(language)s."
msgstr "Le site n’a pas de langue %(language)s."

msgid "You are not allowed to change this page."
msgstr "Vous n’êtes pas autorisé à modifier cette page."

msgid "Imported: %(count)s"
msgstr "Importés : %(count)s"

msgid "Skipped, source changed since the export: %(count)s"
msgstr "Ignorés, source modifiée depuis l’export : %(count)s"

msgid "Not translated in the file: %(count)s"
msgstr "Non traduits dans le fichier : %(count)s"

msgid "Formatting changed, not imported: %(count)s"
msgstr "Mise en forme modifiée, non importés : %(count)s"

msgid "Not in the file: %(count)s"
msgstr "Absents du fichier : %(count)s"

msgid "Translation review"
msgstr "Révision des traductions"

msgid ""
"Translations into this language go through Supertext's review service, so "
"reviewers can check and correct them on the website with the Supertext "
"Localization Review extension. Their corrections are used the next time the "
"page is translated."
msgstr ""
"Les traductions vers cette langue passent par le service de révision de "
"Supertext, afin que les réviseurs puissent les vérifier et les corriger "
"directement sur le site avec l'extension Supertext Localization Review. "
"Leurs corrections sont reprises lors de la prochaine traduction de la page."

msgid "Translation review for %(name)s"
msgstr "Révision des traductions pour %(name)s"

msgid "Review service"
msgstr "Service de révision"

msgid "Off (REVIEW_URL is empty)"
msgstr "Désactivé (REVIEW_URL est vide)"
