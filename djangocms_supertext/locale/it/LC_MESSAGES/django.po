#
msgid ""
msgstr ""
"Project-Id-Version: djangocms-supertext-translation\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "API"
msgstr "API"

msgid "API key"
msgstr "Chiave API"

msgid "Already translated"
msgstr "Già tradotta"

msgid "Already translated."
msgstr "Già tradotta."

msgid "Can translate pages with Supertext"
msgstr "Può tradurre pagine con Supertext"

msgid ""
"Checks the API key against the Supertext API. Nothing is translated or "
"charged."
msgstr ""
"Verifica la chiave API presso l’API Supertext. Non viene tradotto né "
"addebitato nulla."

msgid "Connection"
msgstr "Connessione"

msgid "Default"
msgstr "Predefinito"

msgid "Form of address"
msgstr "Forma di cortesia"

msgid "Formal (Sie, vous)"
msgstr "Formale (Sie, vous)"

msgid "From"
msgstr "Da"

msgid "Informal (du, tu)"
msgstr "Informale (du, tu)"

msgid "Into"
msgstr "In"

msgid "Language"
msgstr "Lingua"

msgid "Languages"
msgstr "Lingue"

msgid ""
"Languages that already exist are replaced by a new translation of the "
"source: the page fields and all plugins. Changes made in those languages are"
" lost. Leave this off to translate only the missing languages."
msgstr ""
"Le lingue già esistenti vengono sostituite da una nuova traduzione "
"dell’originale: i campi della pagina e tutti i plugin. Le modifiche "
"apportate in queste lingue vanno perse. Lasci l’opzione disattivata per "
"tradurre solo le lingue mancanti."

msgid "Missing: set SUPERTEXT_API_KEY"
msgstr "Mancante: imposti SUPERTEXT_API_KEY"

msgid "No Supertext API key is configured. Set SUPERTEXT_API_KEY."
msgstr "Nessuna chiave API Supertext configurata. Imposti SUPERTEXT_API_KEY."

msgid "Open"
msgstr "Apri"

msgid ""
"Open a language to review it, or close this dialog and reload the page."
msgstr ""
"Apra una lingua per rivederla, oppure chiuda questa finestra e ricarichi la "
"pagina."

msgid "Overwrite existing translations"
msgstr "Sovrascrivi le traduzioni esistenti"

msgid "Page"
msgstr "Pagina"

msgid "Set (SUPERTEXT setting)"
msgstr "Impostata (impostazione SUPERTEXT)"

msgid "Set (environment variable SUPERTEXT_API_KEY)"
msgstr "Impostata (variabile d’ambiente SUPERTEXT_API_KEY)"

msgid "Settings"
msgstr "Impostazioni"

msgid "Settings and connection"
msgstr "Impostazioni e connessione"

msgid "Supertext"
msgstr "Supertext"

msgid ""
"Supertext is not set up yet: an administrator needs to set "
"SUPERTEXT_API_KEY."
msgstr ""
"Supertext non è ancora configurato: un amministratore deve impostare "
"SUPERTEXT_API_KEY."

msgid "Supertext language"
msgstr "Lingua Supertext"

msgid "Supertext settings"
msgstr "Impostazioni Supertext"

msgid ""
"Supertext translates the saved content of the source language. Each language"
" takes a few seconds."
msgstr ""
"Supertext traduce il contenuto salvato della lingua di origine. Ogni lingua "
"richiede qualche secondo."

msgid "Supertext translation"
msgstr "Traduzione Supertext"

msgid "Supertext translations"
msgstr "Traduzioni Supertext"

msgid "Test connection"
msgstr "Verifica connessione"

msgid "The page has no %(language)s version to translate from."
msgstr "La pagina non ha una versione %(language)s da cui tradurre."

msgid ""
"This language is published. Create a draft of it, then translate again."
msgstr "Questa lingua è pubblicata. Ne crei una bozza, poi traduca di nuovo."

msgid "Timeout per language"
msgstr "Timeout per lingua"

msgid "Plugin version"
msgstr "Versione del plugin"

msgid "Translate"
msgstr "Traduci"

msgid "Translate with Supertext"
msgstr "Traduci con Supertext"

msgid "Translated with Supertext on %(date)s"
msgstr "Tradotta con Supertext il %(date)s"

msgid "Translating…"
msgstr "Traduzione in corso…"

msgid "already translated, skipped"
msgstr "già tradotta, saltata"

msgid "date"
msgstr "data"

msgid "error"
msgstr "errore"

msgid "from"
msgstr "da"

msgid "into"
msgstr "in"

msgid "message"
msgstr "messaggio"

msgid "page"
msgstr "pagina"

msgid "skipped"
msgstr "saltata"

msgid "status"
msgstr "stato"

msgid "translated"
msgstr "tradotta"

msgid "translation created"
msgstr "traduzione creata"

msgid "translation replaced"
msgstr "traduzione sostituita"

msgid "user"
msgstr "utente"

msgid ""
"No Supertext account yet? <a href=\"%(signup_url)s\" target=\"_blank\" "
"rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at "
"<a href=\"%(api_key_url)s\" target=\"_blank\" rel=\"noopener\">supertext.com"
" → Integrations → API</a> (requires the Admin role)."
msgstr ""
"Non ha ancora un account Supertext? <a href=\"%(signup_url)s\" "
"target=\"_blank\" rel=\"noopener\">Ne crei uno su supertext.com</a>. Generi "
"la Sua chiave API su <a href=\"%(api_key_url)s\" target=\"_blank\" "
"rel=\"noopener\">supertext.com → Integrations → API</a> (richiede il ruolo "
"Admin)."

msgid "Supertext did not return a file id."
msgstr "Supertext non ha restituito un ID file."

msgid "Supertext could not translate the document."
msgstr "Supertext non è riuscito a tradurre il documento."

msgid ""
"Your Supertext translation limit is exceeded. Please upgrade your "
"subscription."
msgstr ""
"Il Suo limite di traduzione Supertext è stato superato. La preghiamo di "
"aggiornare il Suo abbonamento."

msgid "The document was deleted at Supertext before it could be downloaded."
msgstr ""
"Il documento è stato eliminato da Supertext prima che potesse essere "
"scaricato."

msgid "Timed out waiting for the Supertext translation."
msgstr "Tempo scaduto in attesa della traduzione Supertext."

msgid "The translated document was empty."
msgstr "Il documento tradotto era vuoto."

msgid ""
"No Supertext API key is configured. No Supertext account yet? Create one at "
"%(signup_url)s. Generate your API key at %(api_key_url)s (supertext.com → "
"Integrations → API, requires the Admin role)."
msgstr ""
"Nessuna chiave API Supertext configurata. Non ha ancora un account "
"Supertext? Ne crei uno su %(signup_url)s. Generi la Sua chiave API su "
"%(api_key_url)s (supertext.com → Integrations → API, richiede il ruolo "
"Admin)."

msgid "Could not reach Supertext: %(error)s"
msgstr "Impossibile raggiungere Supertext: %(error)s"

msgid ""
"Authentication failed. Please check the Supertext API key. No Supertext "
"account yet? Create one at %(signup_url)s. Generate a new API key at "
"%(api_key_url)s (requires the Admin role)."
msgstr ""
"Autenticazione non riuscita. Verifichi la chiave API Supertext. Non ha "
"ancora un account Supertext? Ne crei uno su %(signup_url)s. Generi una nuova"
" chiave API su %(api_key_url)s (richiede il ruolo Admin)."

msgid "The requested Supertext resource was not found."
msgstr "La risorsa Supertext richiesta non è stata trovata."

msgid "The content is too large for Supertext to translate in one go."
msgstr ""
"Il contenuto è troppo grande per essere tradotto da Supertext in una sola "
"volta."

msgid "Too many requests to Supertext. Please try again shortly."
msgstr "Troppe richieste a Supertext. Riprovi tra poco."

msgid "The Supertext service is currently unavailable."
msgstr "Il servizio Supertext non è al momento disponibile."

msgid "Supertext answered with HTTP %(code)s."
msgstr "Supertext ha risposto con HTTP %(code)s."

msgid "API key check"
msgstr "Verifica della chiave API"

msgid "API key checked: the connection to Supertext works."
msgstr "Chiave API verificata: la connessione a Supertext funziona."

msgid ""
"No API key is set yet. No Supertext account yet? Create one at "
"supertext.com. Generate your API key at supertext.com → Integrations → API "
"(requires the Admin role)."
msgstr ""
"Non è ancora stata inserita alcuna chiave API. Non ha ancora un account "
"Supertext? Ne crei uno su supertext.com. Generi la Sua chiave API su "
"supertext.com → Integrations → API (richiede il ruolo Admin)."

msgid "Not checked yet."
msgstr "Non ancora verificata."

msgid "Off (SUPERTEXT_VERSION_REPORTS=0)"
msgstr "Disattivato (SUPERTEXT_VERSION_REPORTS=0)"

msgid "Off (VERSION_REPORTS in the SUPERTEXT setting)"
msgstr "Disattivato (VERSION_REPORTS nell'impostazione SUPERTEXT)"

msgid "On"
msgstr "Attivo"

msgid "Ping address"
msgstr "Indirizzo di ping"

msgid "Send version information to Supertext"
msgstr "Inviare le informazioni sulla versione a Supertext"

msgid ""
"Sends the site URL and the versions of this plugin, django CMS and the "
"runtime to Supertext after an update and when the API key changes, so "
"Supertext support can see which version you run. No content, no API key and "
"no personal data are sent. Turn it off with VERSION_REPORTS: False in the "
"SUPERTEXT setting or SUPERTEXT_VERSION_REPORTS=0."
msgstr ""
"Invia a Supertext l'URL del sito e le versioni di questo plugin, di django "
"CMS e dell'ambiente di esecuzione dopo un aggiornamento e quando la chiave "
"API cambia. In questo modo l'assistenza Supertext vede quale versione "
"utilizza. Non vengono trasmessi contenuti, chiavi API né dati personali. Lo "
"disattivi con VERSION_REPORTS: False nell'impostazione SUPERTEXT o con "
"SUPERTEXT_VERSION_REPORTS=0."

msgid "Status"
msgstr "Stato"

msgid "Supertext languages"
msgstr "Lingue Supertext"

msgid "Supertext offers no formal/informal choice for this language"
msgstr "Supertext non offre una scelta formale/informale per questa lingua"

msgid ""
"Supertext rejected the API key. Check that you copied the whole key, or "
"generate a new one at supertext.com → Integrations → API (requires the Admin"
" role). No Supertext account yet? Create one at supertext.com."
msgstr ""
"Supertext ha rifiutato la chiave API. Verifichi di aver copiato l'intera "
"chiave oppure ne generi una nuova su supertext.com → Integrations → API "
"(richiede il ruolo Admin). Non ha ancora un account Supertext? Ne crei uno "
"su supertext.com."

msgid ""
"The API key couldn't be checked because Supertext can't be reached. The "
"settings are saved; check again later."
msgstr ""
"Non è stato possibile verificare la chiave API perché Supertext non è "
"raggiungibile. Le impostazioni sono salvate; riprovi più tardi."

msgid ""
"The API key couldn't be checked: Supertext answered with an error "
"(%(status)s). The settings are saved; check again later."
msgstr ""
"Non è stato possibile verificare la chiave API: Supertext ha risposto con un"
" errore (%(status)s). Le impostazioni sono salvate; riprovi più tardi."

msgid "checked %(time)s"
msgstr "verificata %(time)s"

msgid "%(code)s is not a Supertext language."
msgstr "%(code)s non è una lingua Supertext."

msgid ""
"Choose the Supertext language for each django CMS language. It is used in "
"both directions: to translate into the language and from it. A suggestion is"
" preselected where Supertext has an obvious one (de → German (Germany), en →"
" English (US), es-es → Spanish); choose another one if your site means "
"something else (e.g. de-CH for Swiss German)."
msgstr ""
"Scelga la lingua Supertext per ogni lingua di django CMS. Vale in entrambe "
"le direzioni: per tradurre verso la lingua e a partire da essa. Dove "
"Supertext ne ha una ovvia, viene preselezionata (de → tedesco (Germania), en"
" → inglese (USA), es-es → spagnolo); ne scelga un’altra se il Suo sito "
"intende altro (p. es. it-CH per l’italiano svizzero)."

msgid "No choice for this language"
msgstr "Nessuna scelta per questa lingua"

msgid ""
"No Supertext language: choose one, otherwise this language cannot be "
"translated."
msgstr ""
"Nessuna lingua Supertext: ne scelga una, altrimenti questa lingua non può "
"essere tradotta."

msgid "Save languages"
msgstr "Salva lingue"

msgid ""
"Set under LANGUAGES in the SUPERTEXT setting, which wins over this page."
msgstr ""
"Impostato in LANGUAGES nell’impostazione SUPERTEXT, che ha la precedenza su "
"questa pagina."

msgid "Set under LANGUAGES in the SUPERTEXT setting."
msgstr "Impostato in LANGUAGES nell’impostazione SUPERTEXT."

msgid "Suggested. It is used until you choose another one."
msgstr "Suggerimento. Viene usato finché non ne sceglie un’altra."

msgid ""
"Supertext does not support this language pair (%(source)s → %(target)s). "
"Check the Supertext languages under Supertext → Supertext translations → "
"Settings and connection → Languages."
msgstr ""
"Supertext non supporta questa coppia di lingue (%(source)s → %(target)s). "
"Verifichi le lingue Supertext in Supertext → Traduzioni Supertext → "
"Impostazioni e connessione → Lingue."

msgid "Supertext language for %(name)s"
msgstr "Lingua Supertext per %(name)s"

msgid ""
"Supertext offers no formal or informal tone for this language (%(target)s). "
"Set its form of address to the default under Supertext → Supertext "
"translations → Settings and connection → Languages."
msgstr ""
"Supertext non offre un tono formale o informale per questa lingua "
"(%(target)s). Imposti la forma di cortesia su «Predefinito» in Supertext → "
"Traduzioni Supertext → Impostazioni e connessione → Lingue."

msgid "The Supertext languages were saved."
msgstr "Le lingue Supertext sono state salvate."

msgid ""
"The language %(language)s has no Supertext language yet. Ask your "
"administrator to choose one under Supertext → Supertext translations → "
"Settings and connection → Languages."
msgstr ""
"La lingua %(language)s non ha ancora una lingua Supertext. Chieda al Suo "
"amministratore di sceglierne una in Supertext → Traduzioni Supertext → "
"Impostazioni e connessione → Lingue."

msgid "django CMS language"
msgstr "lingua django CMS"

msgid "form of address"
msgstr "forma di cortesia"

msgid "— choose —"
msgstr "— scegliere —"

msgid "File format"
msgstr "Formato del file"

msgid "XLIFF 1.2 (for translation tools)"
msgstr "XLIFF 1.2 (per strumenti di traduzione)"

msgid "HTML (one language per file)"
msgstr "HTML (una lingua per file)"

msgid "Translated file (XLIFF or HTML)"
msgstr "File tradotto (XLIFF o HTML)"

msgid "Also import texts whose source changed since the export"
msgstr ""
"Importa anche i testi il cui testo di partenza è cambiato dopo "
"l’esportazione"

msgid "Export for translation"
msgstr "Esporta per la traduzione"

msgid "Import translation"
msgstr "Importa traduzione"

msgid "Download file"
msgstr "Scarica il file"

msgid ""
"Translate the file in a translation tool, by a translator or in the "
"Supertext web app, then import it here."
msgstr ""
"Faccia tradurre il file in uno strumento di traduzione, da un traduttore o "
"nell’app web Supertext, poi lo importi qui."

msgid "The file is too large (at most 10 MB)."
msgstr "Il file è troppo grande (al massimo 10 MB)."

msgid "Choose one language for an HTML file, or one or more for XLIFF."
msgstr "Scelga una lingua per un file HTML, oppure una o più per XLIFF."

msgid "Nothing to translate."
msgstr "Niente da tradurre."

msgid "This file isn't a valid XLIFF or HTML translation file."
msgstr "Questo file non è un file di traduzione XLIFF o HTML valido."

msgid ""
"This file wasn't exported by the Supertext plugin, or its header was "
"removed."
msgstr ""
"Questo file non è stato esportato dal plugin Supertext oppure la sua "
"intestazione è stata rimossa."

msgid "This file belongs to another system (%(plugin)s)."
msgstr "Questo file appartiene a un altro sistema (%(plugin)s)."

msgid "The page this file was exported from no longer exists."
msgstr "La pagina da cui è stato esportato questo file non esiste più."

msgid "The site has no language %(language)s."
msgstr "Il sito non ha la lingua %(language)s."

msgid "You are not allowed to change this page."
msgstr "Non è autorizzato a modificare questa pagina."

msgid "Imported: %(count)s"
msgstr "Importati: %(count)s"

msgid "Skipped, source changed since the export: %(count)s"
msgstr "Saltati, testo di partenza modificato dopo l’esportazione: %(count)s"

msgid "Not translated in the file: %(count)s"
msgstr "Non tradotti nel file: %(count)s"

msgid "Formatting changed, not imported: %(count)s"
msgstr "Formattazione modificata, non importati: %(count)s"

msgid "Not in the file: %(count)s"
msgstr "Non presenti nel file: %(count)s"

msgid "Translation review"
msgstr "Revisione delle traduzioni"

msgid ""
"Translations into this language go through Supertext's review service, so "
"reviewers can check and correct them on the website with the Supertext "
"Localization Review extension. Their corrections are used the next time the "
"page is translated."
msgstr ""
"Le traduzioni in questa lingua passano dal servizio di revisione di "
"Supertext, così i revisori possono controllarle e correggerle direttamente "
"sul sito con l'estensione Supertext Localization Review. Le loro correzioni "
"vengono riprese alla prossima traduzione della pagina."

msgid "Translation review for %(name)s"
msgstr "Revisione delle traduzioni per %(name)s"

msgid "Review service"
msgstr "Servizio di revisione"

msgid "Off (REVIEW_URL is empty)"
msgstr "Disattivato (REVIEW_URL è vuoto)"
